{
  "name": "angular-cebu-portal-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "npm test -- --config ./test/jest-e2e.json",
    "lint:fix": "npm run lint -- --fix",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "auth:set-role": "node --env-file-if-exists=.env scripts/set-role.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "bcrypt": "6.0.0",
    "better-auth": "1.7.7",
    "express": "5.2.1",
    "mongoose": "9.11.2",
    "passport": "0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "source-map-support": "^0.5.20",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "Node",
            "ignoreDeprecations": "6.0",
            "isolatedModules": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
